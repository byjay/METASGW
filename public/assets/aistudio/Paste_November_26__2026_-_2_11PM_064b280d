const ALLOWED_ORIGINS = [
  'https://sgw.seastar.work',
  'https://get.seastar.work',
  'https://fence.sedms.app'
];

export interface SafePayload {
  ns: 'sgw:v1';
  event: string;
  timestamp: number;
  data: record<string, unknown>;
}

export class PostMessageGuard {
  public static initListener(onValidMessage: (payload: SafePayload) => void) {
    window.addEventListener('message', (event: MessageEvent) => {
      // 1. Origin 검증
      if (!ALLOWED_ORIGINS.includes(event.origin)) {
        console.warn(`[Security Alert] Blocked message from unauthorized origin: ${event.origin}`);
        return;
      }

      // 2. Structural Type 검증
      const payload = event.data as SafePayload;
      if (!payload || payload.ns !== 'sgw:v1') {
        return;
      }

      // 3. 30초 Time-skew 검증
      const now = Date.now();
      if (Math.abs(now - payload.timestamp) > 30000) {
        console.warn('[Security Alert] Blocked expired message frame');
        return;
      }

      onValidMessage(payload);
    });
  }

  // 전환 시 4단계 파기 절차
  public static purgeModuleSession(): void {
    // ① SGW_SESSION_TERMINATE 브로드캐스트
    window.postMessage({ ns: 'sgw:v1', event: 'SGW_SESSION_TERMINATE', timestamp: Date.now(), data: {} }, '*');

    // ② 스토리지 소거
    sessionStorage.clear();
    
    // ③ WebGL Context Force Loss
    const canvasElements = document.querySelectorAll('canvas');
    canvasElements.forEach((canvas) => {
      const gl = canvas.getContext('webgl') || canvas.getContext('webgl2');
      if (gl) {
        const ext = gl.getExtension('WEBGL_lose_context');
        if (ext) ext.forceLoseContext();
      }
    });

    console.log('[System] Module session fully purged.');
  }
}


