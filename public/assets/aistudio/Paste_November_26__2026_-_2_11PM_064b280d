export interface EgoContext {
  projectId: string;
  userId: string;
  role: string;
  isExternal: boolean;
  allowedRoomIds: string[];
}

export class EgoAgentGuard {
  public static validateRequest(ctx: EgoContext, actionName: string): boolean {
    // ① 외부 협력사 접근 제어
    if (ctx.isExternal) {
      throw new Error('EGO_AI_ACCESS_DENIED_FOR_EXTERNAL');
    }

    // ② 불변 컨텍스트 바인딩 확인
    if (!ctx.projectId || !ctx.userId) {
      throw new Error('INVALID_BOUND_CONTEXT');
    }

    // ③ 상태 변경 및 외부 전송 도구에 대한 인가 확인
    const restrictedActions = ['SEND_EXTERNAL_EMAIL', 'MUTATE_DATABASE', 'PURGE_LOGS'];
    if (restrictedActions.includes(actionName) && ctx.role !== 'admin') {
      throw new Error('ACTION_REQUIRES_ADMIN_CONFIRMATION');
    }

    return true;
  }
}


