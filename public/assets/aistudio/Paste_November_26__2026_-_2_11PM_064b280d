export interface Env {
SESSION_KV: KVNamespace;
DB: D1Database;
SGW_SSO_SECRET: string;
}

export const onRequest: PagesFunction = async (context) => {
const { request, env } = context;
const url = new URL(request.url);

// 메타스페이스 접근 경로 검증
if (url.pathname.startsWith('/space/')) {
const pathSegments = url.pathname.split('/');
const tenantId = pathSegments[2];
const projectId = pathSegments[3];

if (!tenantId || !projectId) {
  return new Response(JSON.stringify({ error: 'INVALID_METASPACE_PATH' }), { status: 400 });
}

const authHeader = request.headers.get('Authorization');
const token = authHeader ? authHeader.replace('Bearer ', '') : url.searchParams.get('ticket');

if (!token) {
  return new Response(JSON.stringify({ error: 'UNAUTHORIZED_ACCESS' }), { status: 401 });
}

// SESSION_KV 검증 및 Revoke 상태 확인
const sessionData = await env.SESSION_KV.get<{ actorId: string; role: string; tokenVersion: number }>(`session:${token}`, 'json');
if (!sessionData) {
  return new Response(JSON.stringify({ error: 'EXPIRED_OR_INVALID_TICKET' }), { status: 401 });
}

const isRevoked = await env.SESSION_KV.get(`revoked:${sessionData.actorId}:${projectId}`);
if (isRevoked) {
  return new Response(JSON.stringify({ error: 'ACCESS_REVOKED' }), { status: 403 });
}

// 주입 안전 헤더 생성
const newHeaders = new Headers(request.headers);
newHeaders.set('X-Tenant-Id', tenantId);
newHeaders.set('X-Project-Id', projectId);
newHeaders.set('X-Actor-Id', sessionData.actorId);
newHeaders.set('X-Actor-Role', sessionData.role);

return context.next(new Request(request.url, { headers: newHeaders }));

}

return context.next();
};


