import { Request, Response } from 'express';
import * as path from 'path';
import * as fs from 'fs';

const NAS_ROOT = process.env.NAS_STORAGE_ROOT || '/var/sgtalk/nas';

export class MessagingService {
  // 1:1 대화방 생성 및 포커스 이벤트 처리
  public static async createOrGetDM(req: Request, res: Response) {
    const { projectId, targetActorId } = req.body;
    const actorId = req.headers['x-actor-id'] as string;

    const roomId = `dm-${[actorId, targetActorId].sort().join('-')}`;
    
    // DB 처리 로직 (생략: chat_rooms 등록 및 rev 업데이트)
    return res.status(200).json({
      success: true,
      roomId,
      bridgeAction: {
        type: 'OPEN_DM',
        payload: { roomId, targetActorId, projectId }
      }
    });
  }

  // NAS 경로 상위 탈출 방지 파일 업로드 (isPathInsideDir 및 fs.realpathSync)
  public static async uploadNasFile(req: Request, res: Response) {
    const { projectId, scope, roomId } = req.params;
    const fileName = req.headers['x-file-name'] as string;
    
    const now = new Date();
    const year = now.getFullYear().toString();
    const month = String(now.getMonth() + 1).padStart(2, '0');

    const targetDir = path.join(NAS_ROOT, 'projects', projectId, scope, roomId, year, month);
    
    // 경로 상위 탈출 방지 검증
    const resolvedTarget = path.resolve(targetDir);
    const resolvedRoot = path.resolve(NAS_ROOT);
    if (!resolvedTarget.startsWith(resolvedRoot)) {
      return res.status(403).json({ error: 'PATH_TRAVERSAL_DETECTED' });
    }

    fs.mkdirSync(resolvedTarget, { recursive: true });
    const targetFilePath = path.join(resolvedTarget, fileName);

    const writeStream = fs.createWriteStream(targetFilePath);
    req.pipe(writeStream);

    writeStream.on('finish', () => {
      // 심볼릭 링크 탈출 최종 검증
      const realPath = fs.realpathSync(targetFilePath);
      if (!realPath.startsWith(resolvedRoot)) {
        fs.unlinkSync(targetFilePath);
        return res.status(403).json({ error: 'INVALID_SYMBOLIC_LINK' });
      }

      return res.status(201).json({
        success: true,
        nasFileId: path.relative(NAS_ROOT, realPath)
      });
    });
  }
}
